# Odysseus — parallel Docker dev stack
# Copy to .env.dev and run:
#   docker compose -f docker-compose.yml -f docker/dev.yml --env-file .env.dev up -d --build
#
# Uses separate ports and ./data-dev so a production stack on :7000 can stay up.
# Do not commit .env.dev (may contain secrets).
#
# Do not set COMPOSE_FILE here — on Windows the colon separator is treated as
# part of the path. Use -f flags on the command line instead (works on all OSes).

COMPOSE_PROJECT_NAME=odysseus-dev

APP_BIND=127.0.0.1
APP_PORT=7001
ALLOWED_ORIGINS=http://localhost:7001,http://127.0.0.1:7001
NTFY_BASE_URL=http://localhost:8092

# Optional: pin first-boot admin password instead of reading logs
# ODYSSEUS_ADMIN_PASSWORD=change_me_before_first_boot
#
# Forgot password after first boot? See README.md "Forgot admin password?"
# (delete data-dev/auth.json + set ODYSSEUS_ADMIN_PASSWORD, or patch via
# docker compose … exec odysseus and restart).

# GPU on dev — add -f docker/gpu.nvidia.yml (or gpu.amd.yml) after dev.yml:
#   docker compose -f docker-compose.yml -f docker/dev.yml -f docker/gpu.nvidia.yml --env-file .env.dev up -d --build
